@article{chen2024kgstability,
  title     = {From Liquidity Risk to Systemic Risk: {{A}} Use of Knowledge Graph},
  shorttitle = {From Liquidity Risk to Systemic Risk},
  author    = {Chen, Ren-Raw and Zhang, Xiaohu},
